CATALOG_PORT=8001
ORDERS_PORT=8002
BILLING_PORT=8005
FLOWER_PORT=5555
POSTGRES_PORT=5432
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

LOG_LEVEL=INFO
ENV=local

# make up starts the monitoring in infra/docker-compose.obs.yml too: Prometheus, Grafana, Loki,
# Alloy, cAdvisor, the exporters and Flower. true or false
OBS=true

POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shop
# Read-only role the postgres exporter connects as, created on the first start
POSTGRES_EXPORTER_PASSWORD=change-me

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Per Uvicorn worker process. Worst case 5 services x 4 workers x (4 + 0) = 80 connections,
# under Postgres' default max_connections of 100
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=0

# catalog and orders: async (asyncpg) or sync (psycopg2) for the HTTP handlers
DB_DRIVER=async
# Uvicorn worker processes in every service that serves HTTP (billing-worker runs Celery instead),
# and threads per worker for catalog's sync handlers (40 is AnyIO's default)
UVICORN_WORKERS=1
THREADPOOL_SIZE=40
CACHE_ENABLED=false
CACHE_TTL_SECONDS=60
# make seed only: share of products seeded with zero stock, so some orders are always rejected
SEED_ZERO_STOCK_FRACTION=0.1

# Prefork processes per billing-worker container
CELERY_CONCURRENCY=2
QUEUE_DEPTH_INTERVAL_SECONDS=5

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Partitions for every topic, applied by make up. A topic that already exists cannot shrink, so
# make up fails on a mismatch instead of silently keeping the old count
KAFKA_PARTITIONS=3
# inventory and payments containers, each service in its own consumer group: any above
# KAFKA_PARTITIONS get no partition and stay idle
INVENTORY_REPLICAS=1
PAYMENTS_REPLICAS=1

# orders, inventory and payments: how often the outbox poller looks for unpublished events, and
# how long published ones stay in outbox_events before cleanup deletes them (86400 = 24 h)
OUTBOX_POLL_INTERVAL_SECONDS=0.1
OUTBOX_RETENTION_SECONDS=86400

# orders, inventory and payments: kafka (choreographed events) or http (orders calls inventory,
# then payments, and answers POST /orders with the final status). Needs DB_DRIVER=async under http
TRANSPORT=kafka
# orders under TRANSPORT=http: connect timeout for every call, read timeouts per call. Payments
# takes about 13 ms (10 ms simulated provider delay), inventory 1 to 3 ms
HTTP_CONNECT_TIMEOUT_SECONDS=0.5
INVENTORY_TIMEOUT_SECONDS=2
PAYMENTS_TIMEOUT_SECONDS=2
RELEASE_TIMEOUT_SECONDS=0.5
