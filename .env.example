CATALOG_PORT=8001
ORDERS_PORT=8002
PAYMENTS_PORT=8004
BILLING_PORT=8005
FLOWER_PORT=5555
POSTGRES_PORT=5432

LOG_LEVEL=INFO
ENV=local

POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shop

# Per Uvicorn worker process. Worst case 5 services x 4 workers x (4 + 0) = 80 connections,
# under Postgres' default max_connections of 100
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=0

# catalog and orders: async (asyncpg) or sync (psycopg2) for the HTTP handlers
DB_DRIVER=async
# catalog only: Uvicorn worker processes, and threads per worker for sync handlers (40 is AnyIO's
# default)
UVICORN_WORKERS=1
THREADPOOL_SIZE=40
CACHE_ENABLED=false
CACHE_TTL_SECONDS=60
# make seed only: share of products seeded with zero stock, so some orders are always rejected
SEED_ZERO_STOCK_FRACTION=0.1

# Prefork processes per catalog-worker container
CELERY_CONCURRENCY=2
QUEUE_DEPTH_INTERVAL_SECONDS=5

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Partitions for every topic, applied by make up. A topic that already exists cannot shrink, so
# make up fails on a mismatch instead of silently keeping the old count
KAFKA_PARTITIONS=3
# inventory containers, all in one consumer group: any above KAFKA_PARTITIONS get no partition and
# stay idle
INVENTORY_REPLICAS=1

# orders and inventory: how often the outbox poller looks for unpublished events, and how long
# published ones stay in outbox_events before cleanup deletes them (86400 = 24 h)
OUTBOX_POLL_INTERVAL_SECONDS=0.1
OUTBOX_RETENTION_SECONDS=86400
