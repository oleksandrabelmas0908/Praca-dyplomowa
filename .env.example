CATALOG_PORT=8001
ORDERS_PORT=8002
INVENTORY_PORT=8003
PAYMENTS_PORT=8004
BILLING_PORT=8005
POSTGRES_PORT=5432

LOG_LEVEL=INFO
ENV=local

POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shop

# Per Uvicorn worker process. Worst case 5 services x 4 workers x (4 + 0) = 80 connections,
# under Postgres' default max_connections of 100
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=0
